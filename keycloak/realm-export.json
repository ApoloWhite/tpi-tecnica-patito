{
  "realm": "patito",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "ADMINISTRADOR",
        "description": "Administrador de Tecnica Patito"
      },
      {
        "name": "CLIENTE",
        "description": "Cliente que solicita servicios"
      },
      {
        "name": "TECNICO",
        "description": "Tecnico que atiende solicitudes"
      },
      {
        "name": "SISTEMA",
        "description": "Cuenta de servicio para llamadas automáticas entre microservicios"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bda-client",
      "name": "bda-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/browser-callback",
        "http://localhost:*",
        "http://localhost:47300/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "clienteId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clienteId",
            "claim.name": "clienteId",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tecnicoId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tecnicoId",
            "claim.name": "tecnicoId",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ms-solicitudes",
      "name": "ms-solicitudes (cuenta de servicio)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "patito-secret-dev",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Admin",
      "email": "admin1@patito.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMINISTRADOR"
      ]
    },
    {
      "username": "cliente1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carlos",
      "lastName": "Cliente",
      "email": "cliente1@patito.com",
      "credentials": [
        {
          "type": "password",
          "value": "cliente123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CLIENTE"
      ],
      "attributes": {
        "clienteId": [
          "1"
        ]
      }
    },
    {
      "username": "tecnico1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Juan",
      "lastName": "Pérez",
      "email": "tecnico1@patito.com",
      "credentials": [
        {
          "type": "password",
          "value": "tecnico123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TECNICO"
      ],
      "attributes": {
        "tecnicoId": [
          "1"
        ]
      }
    },
    {
      "username": "tecnico2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Gómez",
      "email": "tecnico2@patito.com",
      "credentials": [
        {
          "type": "password",
          "value": "tecnico123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TECNICO"
      ],
      "attributes": {
        "tecnicoId": [
          "2"
