# Copiá este archivo como .env y ajustá los valores. El .env real no se sube a git.

# Credenciales de la consola de administración de Keycloak (http://localhost:47390)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Ventana de aceptación de ofertas en minutos (RN-3). Poné 1 para probar EN-07 rápido.
OFERTA_VENTANA_MINUTOS=15
# Cada cuántos milisegundos revisa el scheduler las ofertas vencidas
OFERTA_SCHEDULER_MS=30000

# Secreto del client "ms-solicitudes" de Keycloak (cuenta de servicio). Tiene que coincidir con el del realm.
MS_SOLICITUDES_CLIENT_SECRET=patito-secret-dev

# API de mapas (OSRM). Si no responde, se usa Haversine.
GEO_URL=https://router.project-osrm.org

# Puertos publicados en el host (cambialos solo si ya están ocupados)
GATEWAY_PORT=47380
FRONTEND_PORT=47300
MS_SOLICITUDES_PORT=47381
MS_TECNICOS_PORT=47382
MS_CLIENTES_PORT=47383
